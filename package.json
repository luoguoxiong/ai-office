{
  "name": "ai-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "桌面端 AI Office 工具(VSCode 风格文件树 + office 文件预览 + AI 修改)",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "pnpm --filter web dev",
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "build:server": "tsc -p tsconfig.node.json",
    "build:web": "pnpm --filter web build",
    "build": "pnpm build:web && pnpm build:server",
    "serve": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && pnpm --filter web typecheck",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "pnpm build && tauri build"
  },
  "dependencies": {
    "@aipack-ai/agent": "^0.0.2",
    "@officecli/officecli": "^1.0.144"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^20.12.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@officecli/officecli",
      "esbuild"
    ]
  }
}
